{
  "name": "codara",
  "version": "0.1.0",
  "description": "Deterministic semantic foundation for discovering and structurally mapping JavaScript and TypeScript projects.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BilalMahmud12/codara.git"
  },
  "bugs": {
    "url": "https://github.com/BilalMahmud12/codara/issues"
  },
  "homepage": "https://github.com/BilalMahmud12/codara#readme",
  "keywords": [
    "semantic-analysis",
    "static-analysis",
    "typescript",
    "code-intelligence"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "codara": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node dist/cli/index.js analyze . --no-write"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
